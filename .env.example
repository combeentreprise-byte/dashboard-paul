# Supabase Postgres connection strings (Project Settings -> Database -> Connection string)
# DATABASE_URL: the pooled connection (port 6543, via PgBouncer) - used at runtime, serverless-friendly.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: the direct connection (port 5432) - required by Prisma Migrate, which needs prepared statements
# that PgBouncer's transaction pooling mode doesn't support.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Everbill API
EVERBILL_API_URL="https://api.everbill.com"
EVERBILL_API_KEY=""

# Shared secret required in the Authorization header when triggering /api/sync/*
# Vercel Cron sends this automatically when set as CRON_SECRET in the project env.
CRON_SECRET=""
